<UserControl x:Class="Fitness.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="#1e1e2e">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="训练日历" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <Button x:Name="BtnPrev" Content="‹" Width="32" Height="28" Margin="16,0,4,0"
                    Background="#3a3a4c" Foreground="White" Click="BtnPrev_Click" />
            <TextBlock x:Name="TxtMonth" Width="140" Foreground="White" FontSize="16"
                       VerticalAlignment="Center" TextAlignment="Center" />
            <Button x:Name="BtnNext" Content="›" Width="32" Height="28" Margin="4,0,0,0"
                    Background="#3a3a4c" Foreground="White" Click="BtnNext_Click" />
            <Button x:Name="BtnToday" Content="今天" Width="60" Height="28" Margin="12,0,0,0"
                    Background="#3a6ea5" Foreground="White" Click="BtnToday_Click" />
        </StackPanel>

        <!-- 星期表头 -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
            <TextBlock Text="日" Foreground="#a0a0b0" TextAlignment="Center" />
            <TextBlock Text="一" Foreground="#a0a0b0" TextAlignment="Center" />
            <TextBlock Text="二" Foreground="#a0a0b0" TextAlignment="Center" />
            <TextBlock Text="三" Foreground="#a0a0b0" TextAlignment="Center" />
            <TextBlock Text="四" Foreground="#a0a0b0" TextAlignment="Center" />
            <TextBlock Text="五" Foreground="#a0a0b0" TextAlignment="Center" />
            <TextBlock Text="六" Foreground="#a0a0b0" TextAlignment="Center" />
        </UniformGrid>

        <UniformGrid x:Name="CalGrid" Grid.Row="2" Columns="7" />

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="TxtDayTitle" Foreground="White" FontWeight="Bold" />
            <ListBox x:Name="LstDay" Background="#2a2a3c" Foreground="White" Height="120" BorderBrush="#444">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock FontWeight="Bold">
                                <Run Text="{Binding ProjectName}" /><Run Text="  ·  " />
                                <Run Text="{Binding SetSummary}" /><Run Text=" 次" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#a0a0b0">
                                <Run Text="组数 " /><Run Text="{Binding SetCount}" /><Run Text="，共 " />
                                <Run Text="{Binding TotalReps}" /><Run Text=" 次" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
