<UserControl x:Class="Fitness.App.Views.ExecuteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fitness.App"
             Background="#1e1e2e">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：控制 -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="执行训练" FontSize="20" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="选择运动项目，按录制特征自动计次。暂停=完成一组；停止=登记到日历。"
                       Foreground="#a0a0b0" Margin="0,4,0,12" TextWrapping="Wrap" />

            <TextBlock Text="运动项目" Foreground="White" />
            <ComboBox x:Name="CmbProjects" Margin="0,4,0,8" Background="#2a2a3c" Foreground="White"
                      DisplayMemberPath="Name" />

            <CheckBox x:Name="ChkCamera" Content="使用摄像头 (OpenCV 姿态识别，需 yolov8n-pose.onnx)"
                      Foreground="White" Margin="0,0,0,8" Checked="ChkCamera_Changed" Unchecked="ChkCamera_Changed" />

            <CheckBox x:Name="ChkHalfBody" Content="半身模式（仅显示上半身骨骼）"
                      Foreground="White" Margin="0,0,0,8" Checked="ChkHalfBody_Changed" Unchecked="ChkHalfBody_Changed" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnStart" Content="开始训练" Width="84" Margin="0,0,6,0"
                        Background="#2d8c4f" Foreground="White" Click="BtnStart_Click" />
                <Button x:Name="BtnPause" Content="暂停" Width="70" Margin="0,0,6,0" IsEnabled="False"
                        Background="#b59a2f" Foreground="White" Click="BtnPause_Click" />
                <Button x:Name="BtnResume" Content="继续" Width="70" Margin="0,0,6,0" IsEnabled="False"
                        Background="#3a6ea5" Foreground="White" Click="BtnResume_Click" />
                <Button x:Name="BtnStop" Content="停止训练" Width="84" IsEnabled="False"
                        Background="#b5562f" Foreground="White" Click="BtnStop_Click" />
            </StackPanel>

            <Border Background="#2a2a3c" BorderBrush="#444" BorderThickness="1" Padding="10" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Text="当前组次数" Foreground="#a0a0b0" />
                    <TextBlock x:Name="TxtCurrentReps" Text="0" FontSize="32" FontWeight="Bold" Foreground="White" />
                    <ProgressBar x:Name="Prog" Height="14" Minimum="0" Maximum="1" Value="0" Margin="0,4,0,0" />
                    <TextBlock Text="已完成组数 / 总次数" Foreground="#a0a0b0" Margin="0,8,0,0" />
                    <TextBlock x:Name="TxtTotal" Text="0 组 / 0 次" FontSize="16" Foreground="White" />
                    <TextBlock x:Name="TxtSets" TextWrapping="Wrap" Foreground="#c0c0d0" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStatus" Foreground="#c0c0d0" TextWrapping="Wrap" MinHeight="40" />
        </StackPanel>

        <!-- 右：实时骨架 -->
        <Border Grid.Column="1" Background="#0f0f17" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <local:SkeletonCanvas x:Name="Skel" />
                <TextBlock x:Name="TxtOverlay" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Foreground="#ffffff" FontSize="14" Margin="0,8,0,0"
                           Text="请选择运动项目并开始训练" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
