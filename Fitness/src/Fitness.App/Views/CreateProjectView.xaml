<UserControl x:Class="Fitness.App.Views.CreateProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fitness.App"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#1e1e2e">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：录入与项目列表 -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="创建运动项目" FontSize="20" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="录入同一个姿势动作若干次，提取骨骼特征并命名保存。" Foreground="#a0a0b0" Margin="0,4,0,12" TextWrapping="Wrap" />

            <TextBlock Text="项目名称" Foreground="White" />
            <TextBox x:Name="TxtName" Margin="0,4,0,8" Padding="6"
                     Background="#2a2a3c" Foreground="White" BorderBrush="#444" />

            <TextBlock Text="动作说明（可选）" Foreground="White" />
            <TextBox x:Name="TxtDesc" Margin="0,4,0,8" Padding="6" Height="56" TextWrapping="Wrap"
                     Background="#2a2a3c" Foreground="White" BorderBrush="#444" />

            <CheckBox x:Name="ChkCamera" Content="使用摄像头 (OpenCV 姿态识别，需 yolov8n-pose.onnx)"
                      Foreground="White" Margin="0,0,0,8" Checked="ChkCamera_Changed" Unchecked="ChkCamera_Changed" />

            <CheckBox x:Name="ChkHalfBody" Content="半身模式（仅显示上半身骨骼）"
                      Foreground="White" Margin="0,0,0,8" Checked="ChkHalfBody_Changed" Unchecked="ChkHalfBody_Changed" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnStartRec" Content="开始录制" Width="110" Margin="0,0,8,0"
                        Background="#2d8c4f" Foreground="White" Click="BtnStartRec_Click" />
                <Button x:Name="BtnStopRec" Content="停止录制" Width="110" IsEnabled="False"
                        Background="#b5562f" Foreground="White" Click="BtnStopRec_Click" />
            </StackPanel>

            <Button x:Name="BtnSave" Content="保存项目" Width="228" Margin="0,0,0,8"
                    Background="#3a6ea5" Foreground="White" Click="BtnSave_Click" />

            <TextBlock x:Name="TxtStatus" Foreground="#c0c0d0" TextWrapping="Wrap" MinHeight="48" />

            <TextBlock Text="已保存的项目" Foreground="White" Margin="0,12,0,4" />
            <ListBox x:Name="LstProjects" Background="#2a2a3c" Foreground="White" Height="220"
                     BorderBrush="#444">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding JointDescription}" FontSize="11" Foreground="#a0a0b0" />
                            <TextBlock FontSize="11" Foreground="#8a8a9a">
                                <Run Text="录制:" /><Run Text="{Binding RecordedReps}" /><Run Text=" 次 / " />
                                <Run Text="{Binding MinAngle, StringFormat=F0}" /><Run Text="°~" />
                                <Run Text="{Binding MaxAngle, StringFormat=F0}" /><Run Text="°" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- 右：实时骨架 -->
        <Border Grid.Column="1" Background="#0f0f17" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <local:SkeletonCanvas x:Name="Skel" />
                <TextBlock x:Name="TxtOverlay" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Foreground="#ffffff" FontSize="14" Margin="0,8,0,0"
                           Text="点击“开始录制”以采集骨骼姿态" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
