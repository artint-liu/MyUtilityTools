<Window x:Class="Fitness.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fitness.App"
        Title="健身记录助手" Height="680" Width="1040"
        Background="#15151f" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧边导航 -->
        <StackPanel Grid.Column="0" Background="#101019">
            <TextBlock Text="健身记录助手" Foreground="White" FontSize="16" FontWeight="Bold"
                       Margin="16,16,16,4" TextWrapping="Wrap" />
            <TextBlock Text="Fitness Tracker" Foreground="#7a7a90" FontSize="11" Margin="16,0,16,16" />

            <Button x:Name="NavCreate" Content="创建项目" Height="40" Margin="12,4"
                    Background="#2a2a3c" Foreground="White" BorderThickness="0"
                    HorizontalContentAlignment="Left" Padding="14" Click="NavCreate_Click" />
            <Button x:Name="NavCamera" Content="摄像头测试" Height="40" Margin="12,4"
                    Background="#2a2a3c" Foreground="White" BorderThickness="0"
                    HorizontalContentAlignment="Left" Padding="14" Click="NavCamera_Click" />
            <Button x:Name="NavExecute" Content="执行训练" Height="40" Margin="12,4"
                    Background="#2a2a3c" Foreground="White" BorderThickness="0"
                    HorizontalContentAlignment="Left" Padding="14" Click="NavExecute_Click" />
            <Button x:Name="NavCalendar" Content="训练日历" Height="40" Margin="12,4"
                    Background="#2a2a3c" Foreground="White" BorderThickness="0"
                    HorizontalContentAlignment="Left" Padding="14" Click="NavCalendar_Click" />

            <TextBlock Text="姿态分析：OpenCV DNN（开源）" Foreground="#5a5a70" FontSize="10"
                       Margin="16,24,16,0" TextWrapping="Wrap" />
            <TextBlock Text="无摄像头时自动使用模拟演示。" Foreground="#5a5a70" FontSize="10"
                       Margin="16,4,16,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 内容区 -->
        <ContentControl x:Name="Cc" Grid.Column="1" />
    </Grid>
</Window>
