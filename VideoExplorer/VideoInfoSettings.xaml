<Window x:Class="VideoExplorer.VideoInfoSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoExplorer"
        mc:Ignorable="d"
        Title="VideoInfoSettings" Height="450" Width="800">
    <!--<Window.DataContext>
        <local:VideoInfoSettings />
    </Window.DataContext>-->

    <Window.Resources>
        <local:StringToImageSourceConverter x:Key="ImageConverter"/>
        <BitmapImage x:Key="DefaultImage" UriSource="assets/youtube.png"/>
    </Window.Resources>

    <Grid>
        <ListBox x:Name="listBox_Cover" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="412,40,10,171"/>
        <TextBox x:Name="textBox_Title" HorizontalAlignment="Left" Margin="49,274,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="493"/>
        <Image x:Name="image_Cover" HorizontalAlignment="Left" Height="224" Margin="10,40,0,0" VerticalAlignment="Top" Width="390">
        <!--Source="{Binding ImagePath, Converter={StaticResource ImageConverter}, FallbackValue={StaticResource DefaultImage}, TargetNullValue={StaticResource DefaultImage}}">-->
            <Image.Source>
                <Binding Path="ImagePath" FallbackValue="assets/youtube.png" TargetNullValue="assets/youtube.png" Converter="{StaticResource ImageConverter}"/>
            </Image.Source>
        </Image>
        <Label Content="封面" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Label Content="封面列表" HorizontalAlignment="Left" Margin="412,10,0,0" VerticalAlignment="Top"/>
        <Label Content="标题" HorizontalAlignment="Left" Margin="10,270,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
