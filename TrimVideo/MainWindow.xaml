<Window x:Class="TrimVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrimVideo"
        Title="TrimVideo - 视频裁剪工具"
        MinWidth="800" MinHeight="620"
        Width="1100" Height="720"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#505050"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter Property="Background" Value="#222"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#106EBE"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <Button x:Name="BtnOpen" Style="{StaticResource FlatButton}"
                        Content="📂 打开视频" Click="BtnOpen_Click" Margin="0,0,6,0"/>
                <Separator Width="1" Margin="4,2" Background="#555"/>
                <TextBlock x:Name="TxtFilePath" Style="{StaticResource Label}"
                           Text="未打开文件" Margin="8,0" MaxWidth="700"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 视频显示区：用 Image 绑定 WriteableBitmap -->
        <Border Grid.Row="1" Background="Black" Margin="8,8,8,0">
            <Grid>
                <Image x:Name="VideoImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TxtNoFile"
                           Text="拖放视频文件到此处，或点击「打开视频」"
                           Foreground="#666" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- 处理中遮罩 -->
                <Border x:Name="LoadingOverlay" Visibility="Collapsed"
                        Background="#AA000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳ 正在处理..." Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="PbProgress" Width="300" Height="8" Margin="0,12,0,0"
                                     Background="#444" Foreground="#0078D4" BorderThickness="0"
                                     Value="0" Maximum="1" Minimum="0"/>
                        <TextBlock x:Name="TxtProgress" Foreground="#CCC" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" Text="0%"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 时间轴 -->
        <Border Grid.Row="2" Background="#252526" Margin="8,6,8,0" Padding="8,6" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <local:RangeSlider x:Name="RangeSlider"
                                   Grid.Row="0" Height="46"
                                   Minimum="0" Maximum="100"
                                   LowerValue="0" UpperValue="100" Value="0"
                                   LowerValueChanged="RangeSlider_LowerValueChanged"
                                   UpperValueChanged="RangeSlider_UpperValueChanged"
                                   ValueChanged="RangeSlider_ValueChanged"
                                   DragCompleted="RangeSlider_DragCompleted"/>
            </Grid>
        </Border>

        <!-- 控制区 -->
        <Border Grid.Row="3" Background="#2D2D2D" Margin="8,6,8,0" Padding="10,8" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPlayPause" Grid.Column="0" Style="{StaticResource FlatButton}"
                        Click="BtnPlayPause_Click" Width="36" Height="34" IsEnabled="False" Padding="0">
                    <Path x:Name="IconPlayPause" Data="M5,2 L5,18 L17,10 Z" Fill="White"
                          Width="12" Height="16" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnStop" Grid.Column="1" Style="{StaticResource FlatButton}"
                        Click="BtnStop_Click" Margin="6,0,0,0" Width="36" Height="34" IsEnabled="False" Padding="0">
                    <Path Data="M3,3 L17,3 L17,17 L3,17 Z" Fill="White"
                          Width="12" Height="12" Stretch="Uniform"/>
                </Button>
                <ToggleButton x:Name="ChkLoop" Grid.Column="2"
                              ToolTip="循环播放"
                              Width="36" Height="34" Padding="0"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="False">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#3C3C3C"/>
                            <Setter Property="Foreground" Value="#888"/>
                            <Setter Property="BorderBrush" Value="#555"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <Path Data="M12,4 C8.14,4 5,7.13 5,11 L5,12 L2,12 L6,16 L10,12 L7,12 L7,11 C7,8.24 9.24,6 12,6 C14.76,6 17,8.24 17,11 C17,13.76 14.76,16 12,16 C11.04,16 10.16,15.7 9.4,15.2 L8.2,16.6 C9.33,17.46 10.7,18 12,18 C15.86,18 19,14.87 19,11 C19,7.13 15.86,4 12,4 Z"
                                                  Fill="{TemplateBinding Foreground}"
                                                  Width="16" Height="16" Stretch="Uniform"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#505050"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#222"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#4CAF50"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <!-- 音量控制 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Label}" Text="🔊" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="100"
                            VerticalAlignment="Center"
                            ToolTip="音量控制"
                            AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Label}" Text="当前: "/>
                    <TextBlock x:Name="TxtCurrentTime" Foreground="White" FontFamily="Consolas"
                               FontSize="13" Text="00:00" MinWidth="65"/>
                    <TextBlock Style="{StaticResource Label}" Text="  |  总时长: "/>
                    <TextBlock x:Name="TxtTotalTime" Foreground="#CCC" FontFamily="Consolas"
                               FontSize="13" Text="00:00" MinWidth="65"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Label}" Text="入点: "/>
                    <TextBlock x:Name="TxtStartTime" Foreground="#4CAF50" FontFamily="Consolas"
                               FontSize="13" Text="00:00" MinWidth="65"/>
                    <TextBlock Style="{StaticResource Label}" Text="  出点: "/>
                    <TextBlock x:Name="TxtEndTime" Foreground="#F44336" FontFamily="Consolas"
                               FontSize="13" Text="00:00" MinWidth="65"/>
                    <TextBlock Style="{StaticResource Label}" Text="  片段长: "/>
                    <TextBlock x:Name="TxtSegDuration" Foreground="#FFC107" FontFamily="Consolas"
                               FontSize="13" Text="00:00" MinWidth="65"/>
                </StackPanel>

                <Button x:Name="BtnPreviewSegment" Grid.Column="6" Style="{StaticResource FlatButton}"
                        Content="▶ 预览片段" Click="BtnPreviewSegment_Click" Margin="0,0,6,0" IsEnabled="False"/>
                <Button x:Name="BtnResetRange" Grid.Column="7" Style="{StaticResource FlatButton}"
                        Content="↩ 重置" Click="BtnResetRange_Click" Margin="0,0,6,0" IsEnabled="False"/>
                <Button x:Name="BtnTrim" Grid.Column="8" Style="{StaticResource PrimaryButton}"
                        Content="✂ 保存裁剪" Click="BtnTrim_Click" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="#1B1B1B" BorderBrush="#333" BorderThickness="0,1,0,0"
                Margin="0,6,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Foreground="#888" FontSize="12"
                           Text="就绪" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtVideoInfo" Grid.Column="1" Foreground="#666" FontSize="11" Text=""/>
            </Grid>
        </Border>
    </Grid>
</Window>
